rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Users ───────────────────────────────────────────────────
    // Anyone can read (public license verification). Both the authed user
    // and the admin panel (unauthed) can write. Tighten before going live.
    match /users/{uid} {
      allow read:  if true;
      allow write: if true;
    }

    // ─── Licenses ────────────────────────────────────────────────
    // Public read for desktop-app verification. Open writes so the admin
    // panel can revoke / reactivate / delete keys, AND so Chain-plan owners
    // can issue their own branch licenses.
    match /licenses/{licenseKey} {
      allow read, write, delete: if true;
    }

    // ─── Site config & admin-managed data ────────────────────────
    match /siteConfig/{doc}  { allow read, write: if true; }
    match /reviews/{id}      { allow read, write: if true; }
    match /accounts/{id}     { allow read, write: if true; }
    match /purchases/{id}    { allow read, write: if true; }
    match /billing/{id}      { allow read, write: if true; }

    // ─── New admin features ──────────────────────────────────────
    match /discounts/{code}  { allow read, write: if true; }
    match /admins/{username} { allow read, write: if true; }
    match /audit/{id}        { allow read, write: if true; }
  }
}
